{
  "name": "@ngriffin_uk/auth-password",
  "version": "1.0.1",
  "description": "Password authentication plugin for @ngriffin_uk/auth-core",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js"
  },
  "peerDependencies": {
    "@ngriffin_uk/auth-core": "^0.2.2",
    "@ngriffin_uk/auth-password-hash": "^0.2.1"
  },
  "devDependencies": {
    "@ngriffin_uk/auth-core": "workspace:*",
    "@ngriffin_uk/auth-password-hash": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
