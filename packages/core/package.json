{
  "name": "@ngriffin_uk/auth-core",
  "version": "0.2.0",
  "description": "Runtime-neutral authentication context and storage contracts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
