{
  "name": "@ngriffin_uk/auth-password-hash",
  "version": "0.2.2",
  "description": "Password hashing contracts and secure runtime implementations",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pbkdf2": {
      "types": "./dist/pbkdf2.d.ts",
      "import": "./dist/pbkdf2.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js"
  },
  "dependencies": {
    "@ngriffin_uk/auth-crypto": "workspace:^",
    "@ngriffin_uk/auth-encoding": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
