{
  "name": "@ngriffin_uk/auth-oauth2",
  "version": "0.1.0",
  "description": "Runtime-neutral OAuth 2.0 and OpenID Connect authentication plugin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js"
  },
  "peerDependencies": {
    "@ngriffin_uk/auth-core": "^0.1.0",
    "@ngriffin_uk/auth-crypto": "^0.1.0",
    "@ngriffin_uk/auth-encoding": "^0.1.0",
    "@ngriffin_uk/auth-jwt": "^0.1.0",
    "@ngriffin_uk/auth-request": "^0.1.0"
  },
  "devDependencies": {
    "@ngriffin_uk/auth-core": "workspace:*",
    "@ngriffin_uk/auth-crypto": "workspace:*",
    "@ngriffin_uk/auth-encoding": "workspace:*",
    "@ngriffin_uk/auth-jwt": "workspace:*",
    "@ngriffin_uk/auth-request": "workspace:*"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "license": "Apache-2.0"
}
