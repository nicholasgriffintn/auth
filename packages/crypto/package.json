{
  "name": "@ngriffin_uk/auth-crypto",
  "version": "1.0.3",
  "description": "Runtime-neutral authentication cryptography primitives",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js"
  },
  "peerDependencies": {
    "@ngriffin_uk/auth-encoding": "^0.2.4"
  },
  "devDependencies": {
    "@ngriffin_uk/auth-encoding": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
