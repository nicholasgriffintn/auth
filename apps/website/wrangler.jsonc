{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auth-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "auth.nicholasgriffin.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://auth.nicholasgriffin.dev"
  },
  "secrets": {
    "required": [
      "AUTH_ENCRYPTION_KEY"
    ]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STORE",
        "class_name": "AuthStore"
      }
    ]
  },
  "exports": {
    "AuthStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "78243",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
