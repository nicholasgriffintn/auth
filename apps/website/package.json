{
  "name": "@ngriffin_uk/auth-website",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "prebuild": "pnpm docs:generate",
    "build": "tsc -b && vite build",
    "typecheck": "pnpm docs:generate && tsc -b",
    "test": "pnpm build && node --test tests/*.test.ts",
    "check": "pnpm test && wrangler deploy --dry-run",
    "deploy": "pnpm check && wrangler deploy",
    "dev": "vite",
    "preview": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@ngriffin_uk/auth-cookie": "workspace:*",
    "@ngriffin_uk/auth-core": "workspace:*",
    "@ngriffin_uk/auth-encoding": "workspace:*",
    "@ngriffin_uk/auth-oauth2": "workspace:*",
    "@ngriffin_uk/auth-otp": "workspace:*",
    "@ngriffin_uk/auth-password": "workspace:*",
    "@ngriffin_uk/auth-password-hash": "workspace:*",
    "@ngriffin_uk/auth-provider-amazon-cognito": "workspace:*",
    "@ngriffin_uk/auth-provider-github": "workspace:*",
    "@ngriffin_uk/auth-react": "workspace:*",
    "@ngriffin_uk/auth-request": "workspace:*",
    "@ngriffin_uk/auth-webauthn": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.115.0"
  }
}
