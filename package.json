{
  "name": "@ngriffin_uk/auth-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A reusable auth system for my applications",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:website": "pnpm --filter @ngriffin_uk/auth-website dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm build && pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test",
    "changeset:generate": "pnpm changeset",
    "changeset:version": "pnpm changeset version",
    "publish": "pnpm publish -r"
  },
  "keywords": [],
  "author": "Nicholas Griffin",
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
