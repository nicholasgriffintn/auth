{
  "name": "@ngriffin_uk/auth-provider-bitbucket",
  "version": "3.0.0",
  "description": "bitbucket authentication provider for @ngriffin_uk/auth-core",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@ngriffin_uk/auth-core": "^0.4.0",
    "@ngriffin_uk/auth-oauth2": "^3.0.1"
  },
  "devDependencies": {
    "@ngriffin_uk/auth-core": "workspace:*",
    "@ngriffin_uk/auth-oauth2": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
